[importlinter]
root_packages =
    commerce_ops

[importlinter:contract:module-layers]
name = Module layers (infrastructure -> application -> domain)
type = layers
containers =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent
    commerce_ops.shared
layers =
    infrastructure
    application
    domain

[importlinter:contract:access-domain-boundary]
name = access.domain does not reach outside its own layer
type = forbidden
source_modules =
    commerce_ops.access.domain
forbidden_modules =
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent
    commerce_ops.shared.application
    commerce_ops.shared.infrastructure

[importlinter:contract:access-application-boundary]
name = access.application does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.access.application
forbidden_modules =
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent
    commerce_ops.shared.infrastructure
; Stricter than its peers on purpose: `access` asks the catalog what a SKU
; names through a consumer-owned port the composition root satisfies, so it
; needs no other module at all — not even a public surface. Forbidding
; `catalog` wholesale keeps that closure honest.

[importlinter:contract:access-infrastructure-boundary]
name = access.infrastructure does not reach into other modules
type = forbidden
source_modules =
    commerce_ops.access.infrastructure
forbidden_modules =
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent

[importlinter:contract:briefing-domain-boundary]
name = briefing.domain does not reach outside its own layer
type = forbidden
source_modules =
    commerce_ops.briefing.domain
forbidden_modules =
    commerce_ops.access
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent
    commerce_ops.shared.application
    commerce_ops.shared.infrastructure

[importlinter:contract:briefing-application-boundary]
name = briefing.application does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.briefing.application
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.catalog.domain
    commerce_ops.catalog.infrastructure
    commerce_ops.launch.domain
    commerce_ops.launch.infrastructure
    commerce_ops.omni_agent
    commerce_ops.shared.infrastructure

[importlinter:contract:briefing-infrastructure-boundary]
name = briefing.infrastructure does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.briefing.infrastructure
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.catalog.domain
    commerce_ops.catalog.infrastructure
    commerce_ops.launch.domain
    commerce_ops.launch.infrastructure
    commerce_ops.omni_agent
; The exemption `products-application-boundary` carries, for the same
; reason: calling a module's public surface is the sanctioned cross-module
; path, and that surface necessarily uses its own domain internally.
; Exempting those edges keeps each surface opaque without permitting
; briefing to import another module's domain directly.
ignore_imports =
    commerce_ops.catalog.application -> commerce_ops.catalog.domain.**
    commerce_ops.catalog.application.** -> commerce_ops.catalog.domain.**
    commerce_ops.launch.application.** -> commerce_ops.launch.domain.**

[importlinter:contract:catalog-domain-boundary]
name = catalog.domain does not reach outside its own layer
type = forbidden
source_modules =
    commerce_ops.catalog.domain
forbidden_modules =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.launch
    commerce_ops.omni_agent
    commerce_ops.shared.application
    commerce_ops.shared.infrastructure

[importlinter:contract:catalog-application-boundary]
name = catalog.application does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.catalog.application
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.briefing
    commerce_ops.launch.domain
    commerce_ops.launch.infrastructure
    commerce_ops.omni_agent.domain
    commerce_ops.omni_agent.infrastructure
    commerce_ops.omni_agent.application.graph
    commerce_ops.shared.infrastructure

[importlinter:contract:catalog-infrastructure-boundary]
name = catalog.infrastructure does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.catalog.infrastructure
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.briefing
    commerce_ops.launch.domain
    commerce_ops.launch.infrastructure
    commerce_ops.omni_agent

[importlinter:contract:products-domain-boundary]
name = launch.domain does not reach outside its own layer
type = forbidden
source_modules =
    commerce_ops.launch.domain
forbidden_modules =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.omni_agent
    commerce_ops.shared.application
    commerce_ops.shared.infrastructure

[importlinter:contract:products-application-boundary]
name = launch.application does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.launch.application
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.briefing
    commerce_ops.catalog.domain
    commerce_ops.catalog.infrastructure
    commerce_ops.omni_agent.domain
    commerce_ops.omni_agent.infrastructure
    commerce_ops.omni_agent.application.graph
    commerce_ops.shared.infrastructure
; Calling catalog's public surface (its application/__init__) is the
; sanctioned cross-module path, and that surface necessarily uses its own
; domain internally. Exempting catalog's application->domain edges from
; this contract's chains keeps the public surface opaque without
; permitting launch.application to import catalog.domain directly.
ignore_imports =
    commerce_ops.catalog.application -> commerce_ops.catalog.domain.**
    commerce_ops.catalog.application.** -> commerce_ops.catalog.domain.**

[importlinter:contract:products-infrastructure-boundary]
name = launch.infrastructure does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.launch.infrastructure
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.briefing
    commerce_ops.catalog.domain
    commerce_ops.catalog.infrastructure
    commerce_ops.omni_agent
; The same exemption `products-application-boundary` carries, for the same
; reason, now that launch has driving adapters (the ClickUp completion
; loop) that call their own application layer: infrastructure -> application
; is the sanctioned direction, launch.application may call catalog's public
; surface, and that surface necessarily uses its own domain internally.
; Exempting those edges keeps the surface opaque without permitting
; launch.infrastructure to import catalog.domain directly.
ignore_imports =
    commerce_ops.catalog.application -> commerce_ops.catalog.domain.**
    commerce_ops.catalog.application.** -> commerce_ops.catalog.domain.**

[importlinter:contract:omni-agent-domain-boundary]
name = omni_agent.domain does not reach outside its own layer
type = forbidden
source_modules =
    commerce_ops.omni_agent.domain
forbidden_modules =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.shared.application
    commerce_ops.shared.infrastructure

[importlinter:contract:omni-agent-application-boundary]
name = omni_agent.application does not reach into other modules' internals
type = forbidden
source_modules =
    commerce_ops.omni_agent.application
forbidden_modules =
    commerce_ops.access.domain
    commerce_ops.access.infrastructure
    commerce_ops.briefing
    commerce_ops.catalog.domain
    commerce_ops.catalog.infrastructure
    commerce_ops.launch.domain
    commerce_ops.launch.infrastructure
    commerce_ops.shared.infrastructure

[importlinter:contract:omni-agent-infrastructure-boundary]
name = omni_agent.infrastructure does not reach into other modules
type = forbidden
source_modules =
    commerce_ops.omni_agent.infrastructure
forbidden_modules =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch

[importlinter:contract:shared-boundary]
name = shared never imports a business module
type = forbidden
source_modules =
    commerce_ops.shared
forbidden_modules =
    commerce_ops.access
    commerce_ops.briefing
    commerce_ops.catalog
    commerce_ops.launch
    commerce_ops.omni_agent
